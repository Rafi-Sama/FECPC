# Web app (apps/web). `pnpm dev` copies this to apps/web/.env.local when that file is missing.

# Where the Next server reaches the API. Server-side only; the browser never calls the API directly.
# Unset (Vercel): the API runs inside this app, configured by the API's variables (DATABASE_URL, ...) set here.
API_INTERNAL_URL=http://localhost:3001

# Same value as the API's API_PROXY_SECRET when the API runs on its own host with a public address.
API_PROXY_SECRET=

# 1 when a reverse proxy (or Vercel) in front of the web app sets X-Forwarded-For; the client IP is then passed on. in front of the web app sets X-Forwarded-For; the client IP is then passed on.
TRUST_PROXY=

# Optional Google sign-in (the button always shows; it works once this is set). No secret here: the API holds it.
GOOGLE_CLIENT_ID=
# Must equal the API's GOOGLE_REDIRECT_URI. Default: this site's origin + /api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Optional Cloudflare Turnstile widget on the join form (the API holds the secret).
TURNSTILE_SITE_KEY=
# Optional GitHub sign-in (the button always shows; it works once this is set). No secret here: the API holds it.
GITHUB_CLIENT_ID=
