{
  "name": "@fecpc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./inprocess": "./dist/inprocess.js"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint src test scripts",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fecpc/content": "workspace:*",
    "@fecpc/contracts": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@vercel/functions": "^3.11.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fecpc/config-typescript": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
