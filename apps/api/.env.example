# API (apps/api). Copy to apps/api/.env.local or the repo-root .env.local; both are read, this one first.
# Every value below is the built-in default except SEED_PASSWORD, so local development needs no file at all.

# local | ci | staging | production. Anything but local uses Secure `__Host-` session cookies (HTTPS only).
APP_ENV=local
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# The web app's public origin, and every origin allowed to call the API (CORS + CSRF check).
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Proxy hops in front of the API whose X-Forwarded-For is trusted. The web app is one hop.
TRUST_PROXY=1
RATE_LIMIT_GLOBAL_PER_MIN=300

DATABASE_URL=postgres://fecpc:fecpc_dev@127.0.0.1:5433/fecpc
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=30000

# Sessions slide forward while used (idle) but never outlive the absolute limit.
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=60
SESSION_MAX_PER_USER=10

# Only when the API runs on its own host with a public address: the web app's API_PROXY_SECRET, 32+ random
# characters (openssl rand -hex 32). Every request but /health and /v1/cron must carry it. Empty on Vercel (the API
# runs inside the web app) and on a private network.
API_PROXY_SECRET=
# Bearer token for GET /v1/cron (weekly sheet, mail runs). Vercel Cron sends it; a mail run uses it to start the next.
CRON_SECRET=

# Password given to every placeholder account by `pnpm db:setup` (10+ characters). Seed only.
SEED_PASSWORD=change-me-please

# Optional Google sign-in. The API redeems the code, so the secret lives here only.
# GOOGLE_REDIRECT_URI must equal the web app's (default: APP_PUBLIC_URL/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: email accepted applicants their set-password link. Without it the officer sees the link instead.
# Local (docker compose's Mailpit, inbox at http://localhost:8026): smtp://127.0.0.1:1026
# Gmail: smtps://club%40gmail.com:<app-password>@smtp.gmail.com:465
# Several accounts (different providers) add up their limits: separate URLs with spaces; each may end with
# ?daily=400&per_minute=20&from=Name%20%3Caddress%3E (see docs/deployment.md#email).
SMTP_URL=
MAIL_FROM=
# Optional Cloudflare Turnstile on the join form (pair with the web app's TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=
# Optional GitHub sign-in. OAuth app callback URL: APP_PUBLIC_URL/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
