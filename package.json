{
  "name": "fecpc-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "turbo run format:check",
    "check": "node scripts/check.mjs",
    "verify": "turbo run format:check lint typecheck test build",
    "db:setup": "pnpm --filter @fecpc/api db:migrate && pnpm --filter @fecpc/api db:seed",
    "db:migrate": "pnpm --filter @fecpc/api db:migrate",
    "db:seed": "pnpm --filter @fecpc/api db:seed"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0"
  }
}
